PORT=8000
MONGO_URI=mongodb+srv://USERNAME:PASSWORD@CLUSTER/DATABASE?appName=APP_NAME

JWT_TOKEN_SECRET=your_jwt_secret_here

NODE_CODE_SENDING_EMAIL_ADDRESS=your_email@example.com
NODE_CODE_SENDING_EMAIL_PASSWORD=your_email_app_password

# Brevo (Sendinblue) Email Configuration
# Option 1: Brevo HTTPS REST API (RECOMMENDED for Railway/Render/Cloud hosts - immune to SMTP port blocks)
# Generate key in: Brevo Dashboard -> SMTP & API -> API Keys -> Generate a new API key
BREVO_API_KEY=xkeysib-your_brevo_api_key_here

# Option 2: Brevo SMTP Relay (Works on localhost or cloud hosts with unblocked SMTP ports)
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_USER=your_brevo_login_email
SMTP_PASS=xsmtpsib-your_brevo_smtp_key_here

HMAC_VERIFICATION_CODE_SECRET=your_hmac_secret_here

CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# Frontend website URL (used for links inside customer emails like "Track Your Order")
# For local dev: http://localhost:3000
# For production (Render/Vercel): https://your-site.vercel.app or https://your-site.onrender.com
FRONTEND_URL=http://localhost:3000

# Admin Portal Credentials
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=your_secure_admin_password

